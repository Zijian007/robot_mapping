# Shared algorithm-package style; use clang-format 14.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17
IndentWidth: 2
ContinuationIndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Attach
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# Some algorithm headers depend on declarations/macros from preceding includes.
SortIncludes: Never
